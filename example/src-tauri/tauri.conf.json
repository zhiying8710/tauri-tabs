{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tauri Tabs",
  "version": "0.1.0",
  "identifier": "com.tauri.tauritabs",
  "build": {
    "beforeDevCommand": "npm run dev:example",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:example",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tauri Tabs",
        "width": 1120,
        "height": 760,
        "minWidth": 760,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}